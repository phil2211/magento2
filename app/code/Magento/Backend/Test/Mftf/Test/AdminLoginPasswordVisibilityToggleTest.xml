<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminLoginPasswordVisibilityToggleTest">
        <annotations>
            <features value="Backend"/>
            <stories value="Login on the Admin Login page"/>
            <title value="Admin can toggle password visibility on the Admin Login page"/>
            <description value="Admin can show and hide the password value before signing in."/>
            <severity value="MINOR"/>
            <group value="login"/>
        </annotations>
        <amOnPage url="{{AdminLoginPage.url}}" stepKey="navigateToAdmin"/>
        <fillField selector="{{AdminLoginFormSection.password}}" userInput="Admin123!" stepKey="fillPassword"/>
        <seeElement selector="{{AdminLoginFormSection.showPassword}}" stepKey="seePasswordToggle"/>
        <click selector="{{AdminLoginFormSection.showPassword}}" stepKey="showPassword"/>
        <grabAttributeFrom selector="{{AdminLoginFormSection.password}}" userInput="type" stepKey="shownPasswordType"/>
        <assertEquals stepKey="assertPasswordIsShown">
            <actualResult type="variable">shownPasswordType</actualResult>
            <expectedResult type="string">text</expectedResult>
        </assertEquals>
        <click selector="{{AdminLoginFormSection.showPassword}}" stepKey="hidePassword"/>
        <grabAttributeFrom selector="{{AdminLoginFormSection.password}}" userInput="type" stepKey="hiddenPasswordType"/>
        <assertEquals stepKey="assertPasswordIsHidden">
            <actualResult type="variable">hiddenPasswordType</actualResult>
            <expectedResult type="string">password</expectedResult>
        </assertEquals>
    </test>
</tests>
